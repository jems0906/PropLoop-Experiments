# Local defaults work without this file. For Railway, set the service variables in the dashboard.
DATABASE_URL=sqlite:///./proploop.db
AI_PROVIDER=mock
FRONTEND_URL=http://localhost:5173
# Generate a private random token for initial-admin setup. Never commit a real token.
BOOTSTRAP_TOKEN=
COOKIE_SECURE=false
# Set COOKIE_SECURE=true and FRONTEND_URL to the exact HTTPS frontend origin in production.
QUALITY_INGEST_TOKEN=
# Optional: AI_PROVIDER=openai|anthropic|gemini plus the matching key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional GitHub coding agent; use a repository-scoped fine-grained token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
CODING_AGENT_MODEL=gpt-4o-mini
# Frontend defaults to /api and uses the Vite proxy locally.
VITE_API_URL=/api
